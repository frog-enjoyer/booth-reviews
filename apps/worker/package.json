{
  "name": "@booth-addon/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply booth-addon --local",
    "db:schema:local": "wrangler d1 execute booth-addon --local --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\"",
    "db:seed:local": "wrangler d1 execute booth-addon --local --file seeds/local.sql",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@booth-addon/shared": "workspace:*",
    "hono": "^4.12.18",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251118.0",
    "wrangler": "^4.50.0"
  }
}
